<header class="site-header">

  <div class="logo">
    <%= link_to "TennisNear", root_path %>
  </div>

  <nav class="nav">

    <%= link_to "募集を探す", events_path %>

    <% if user_signed_in? %>

      <%= link_to "募集を作成", new_event_path %>

      <span class="user-email">
        <%= current_user.email %>
      </span>

      <%= button_to "ログアウト",
          destroy_user_session_path,
          method: :delete %>

    <% else %>

      <%= button_to "ゲストログイン",
          users_guest_sign_in_path,
          method: :post %>

      <%= link_to "ログイン", new_user_session_path %>
      <%= link_to "新規登録", new_user_registration_path %>

    <% end %>

  </nav>
</header>