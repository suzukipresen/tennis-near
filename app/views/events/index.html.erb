<div class="search-box">
  <%= form_with url: events_path, method: :get, local: true do %>

    <div class="search-row">

      <div class="search-item">
        <label>日付</label>
        <%= date_field_tag :date, params[:date] %>
      </div>

      <div class="search-item">
        <label>レベル</label>
        <%= select_tag :level,
            options_for_select(
              [["指定なし", ""], ["初心者", 1], ["中級", 2], ["上級", 3]],params[:level]) %>
      </div>

      <div class="search-item">
        <label>場所</label>
        <%= text_field_tag :place, params[:place], placeholder: "場所" %>
      </div>

      <div class="search-item">
        <label>距離</label>

        <%= select_tag :distance,
            options_for_select([["指定なし", ""],["3km", 3],["5km", 5],["10km", 10]],params[:distance]) %>
      </div>

      <div class="search-checkbox">
        <%= check_box_tag :beginner_friendly,"1",params[:beginner_friendly] == "1" %>
        <%= label_tag :beginner_friendly, "初心者歓迎" %>
      </div>

      <%= hidden_field_tag :latitude, params[:latitude], id: "latitude" %>
      <%= hidden_field_tag :longitude, params[:longitude], id: "longitude" %>

      <div>
        <%= submit_tag "検索", class: "search-button" %>
      </div>

      <button type="button" id="current-location-button" class="location-button">現在地を取得</button>

      <div>
       <%= link_to "クリア",events_path,class: "clear-button" %>
      </div>

    </div>

  <% end %>
</div>

<div id="map" class="events-map"></div>

<h1 class="events-title">
募集中のイベント（<%= @events.size %>件）
</h1>

<div class="events-grid">
  <% @events.each do |event| %>
    <div class="event-card">
      <div class="event-card-header">
        <% if event.beginner_friendly? %>
          <span class="tag beginner">初心者歓迎</span>
        <% end %>
        <span class="capacity">
          <%= event.participants.count %>/<%= event.capacity %>名
        </span>
      </div>

      <h3>
        <%= link_to event.title, event_path(event) %>
      </h3>

      <p>📍 <%= event.place %></p>
      <p>
        🕒  <%= event.event_date.strftime("%-m/%-d %H:%M") %>
      </p>
      <p>🎾 レベル <%= event.level_i18n %></p>
      <hr>
      <p>
        主催： <%= event.user.email %>
      </p>
    </div>
  <% end %>

</div>

<script>
  window.markers = <%= raw @markers.to_json %>;

  function initMap() {
    const map = new google.maps.Map(document.getElementById("map"), {
      zoom: 10,
      center: {
        lat: markers[0].lat,
        lng: markers[0].lng
      }
    });

    markers.forEach((marker) => {
      new google.maps.Marker({
        position: {
          lat: marker.lat,
          lng: marker.lng
        },
        map: map,
        title: marker.title
      });
    });
  }

  window.initMap = initMap;

  document
    .getElementById("current-location-button")
    .addEventListener("click", () => {

      navigator.geolocation.getCurrentPosition((position) => {

        document.getElementById("latitude").value =
          position.coords.latitude;

        document.getElementById("longitude").value =
          position.coords.longitude;

        alert("現在地を取得しました！");

      });
     });
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector(".search-box form");

    form.addEventListener("submit", (e) => {
      const lat = document.getElementById("latitude").value;
      const lng = document.getElementById("longitude").value;

      // 距離検索してるのに現在地ない場合だけ止める
      const distance = document.querySelector("[name='distance']").value;

      if (distance && (!lat || !lng)) {
        alert("先に現在地を取得してください");
        e.preventDefault();
      }
    });
  });
</script>

<script async
  src="https://maps.googleapis.com/maps/api/js?key=<%= Rails.application.credentials.google[:maps_api_key] %>&callback=initMap">
</script>