<%= form_with model: @event do |f| %>

  <% if @event.errors.any? %>
    <div class="error-box">
      <h2><%= @event.errors.count %>件のエラーがあります</h2>

      <ul>
        <% @event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
<% end %>

  <div class="field">
    <%= f.label :title, "タイトル" %>
    <%= f.text_field :title %>
  </div>

  <div class="field">
    <%= f.label :event_date, "開催日時" %>
    <%= f.datetime_local_field :event_date, min: Time.current.strftime("%Y-%m-%dT%H:%M") %>
  </div>

  <div class="field">
    <%= f.label :place, "場所" %>
    <%= f.text_field :place %>
  </div>

  <div class="field">
    <%= f.label :level, "レベル" %>
    <%= f.select :level, [["初級", "beginner"],["中級", "intermediate"],["上級", "advanced"]] %>
  </div>

  <div class="field">
    <%= f.label :fee, "参加費" %>
    <%= f.number_field :fee, min: 0 %>
  </div>

  <div class="field">
    <%= f.label :capacity, "募集人数" %>
    <%= f.number_field :capacity, min: 1 %>
  </div>

  <div class="field">
    <%= f.label :description, "詳細" %>
    <%= f.text_area :description %>
  </div>

  <div class="field">
    <%= f.label :beginner_friendly, "初心者歓迎" %>
    <%= f.check_box :beginner_friendly %>
  </div>

  <%= f.submit "募集を作成する",class: "submit-button" %>

<% end %>